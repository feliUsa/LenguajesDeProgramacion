let lista = [10, 20, 30, 40, 50]

print("Elementos en la lista:")
for x in lista {
    print(x)
}


let rango = range(1, 6)

print("Números del rango:")
for x in rango {
    print(x)
}

let lista = [2, 4, 6, 8, 10]

print("Doble de cada número:")
for num in lista {
    let doble = num * 2
    print(doble)
}



