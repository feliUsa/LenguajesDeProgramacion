let matrizA = [[1, 2], [3, 4]]
let matrizB = [[5, 6], [7, 8]]

let sumaMatrices = addMatrix(matrizA, matrizB)
let productoMatrices = multiplyMatrix(matrizA, matrizB)

print("Suma de matrices:")
print(sumaMatrices)

print("Producto de matrices:")
print(productoMatrices)

let transpuesta = transposeMatrix(matrizA)
print("Transpuesta de matrizA:")
print(transpuesta)


